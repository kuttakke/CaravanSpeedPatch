<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CaravanSpeedPatch</AssemblyName>
    <RootNamespace>KTK_CaravanSpeedPatch</RootNamespace>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\CaravanSpeedPatch\Mod.cs" Link="Mod.cs" />
    <Compile Include="..\CaravanSpeedPatch\Patch.cs" Link="Patch.cs" />
    <Compile Include="..\CaravanSpeedPatch\Properties\AssemblyInfo.cs" Link="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.*-*" />
    <PackageReference Include="Lib.Harmony" Version="2.3.6" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\..\1.7\Assemblies\" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(MSBuildThisFileDirectory)..\..\..\1.7\Assemblies\" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>
</Project>
